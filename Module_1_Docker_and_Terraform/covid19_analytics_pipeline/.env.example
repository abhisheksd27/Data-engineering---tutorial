# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=covid19

# ── pgAdmin ─────────────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=root

# ── Data Source ─────────────────────────────────────
# Our World in Data — free, no auth required
DATA_URL=https://covid.ourworldindata.org/data/owid-covid-data.csv

# ── AWS Settings ─────────────────────────────────────
# Get these from IAM → Users → Security credentials → Access keys
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 bucket name must be GLOBALLY UNIQUE across all AWS accounts
# Replace "yourname" and "12345" with something unique to you
S3_BUCKET_NAME=covid19-data-lake-yourname-12345
